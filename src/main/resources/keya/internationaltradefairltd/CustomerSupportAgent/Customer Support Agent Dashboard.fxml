<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="800.0" style="-fx-background-color: #548581;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.CustomerSupportAgent.CustomerSupportAgentDashboardController">
   <children>
      <Label alignment="CENTER" layoutX="250.0" layoutY="35.0" prefHeight="47.0" prefWidth="300.0" text="Trade Fair Support Center" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="24.0" />
         </font>
      </Label>
      <Label fx:id="userNameLabel" layoutX="460.0" layoutY="18.0" text="Welcome, Customer Care Representative" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button layoutX="700.0" layoutY="14.0" mnemonicParsing="false" onAction="#signOutButtonOnAction" style="-fx-background-color: #0e534f;" text="Sign Out" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Label layoutX="30.0" layoutY="100.0" text="Customer Care Representative Dashboard" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="15.0" />
         </font>
      </Label>
      <Button layoutX="30.0" layoutY="140.0" mnemonicParsing="false" onAction="#customerQueriesButtonOnAction" prefHeight="38.0" prefWidth="240.0" text="Customer Queries &amp; Support">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="30.0" layoutY="190.0" mnemonicParsing="false" onAction="#resolveIssuesButtonOnAction" prefHeight="38.0" prefWidth="240.0" text="Resolve Issues &amp; Tickets">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="30.0" layoutY="240.0" mnemonicParsing="false" onAction="#knowledgeBaseButtonOnAction" prefHeight="38.0" prefWidth="240.0" text="Knowledge Base &amp; Guidelines">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="30.0" layoutY="290.0" mnemonicParsing="false" onAction="#faqButtonOnAction" prefHeight="38.0" prefWidth="240.0" text="Frequently Asked Questions (FAQ)">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="30.0" layoutY="340.0" mnemonicParsing="false" onAction="#summaryButtonOnAction" prefHeight="38.0" prefWidth="240.0" text="Fair Summary &amp; Analytics">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button layoutX="700.0" layoutY="495.0" mnemonicParsing="false" onAction="#agentBackButtonOnAction" prefHeight="30.0" prefWidth="75.0" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
