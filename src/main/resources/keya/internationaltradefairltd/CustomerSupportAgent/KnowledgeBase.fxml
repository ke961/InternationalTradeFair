<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="920.0" style="-fx-background-color: #548581;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.CustomerSupportAgent.KnowledgeBaseController">
   <children>
      <Label alignment="CENTER" layoutX="260.0" layoutY="15.0" prefHeight="35.0" prefWidth="400.0" text="Trade Fair Knowledge Base &amp; FAQ" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="23.0" />
         </font>
      </Label>

      <!-- Search & Filters -->
      <Label layoutX="30.0" layoutY="65.0" text="Search Articles:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="searchTextField" layoutX="130.0" layoutY="60.0" prefHeight="26.0" prefWidth="250.0" promptText="Type keyword to search..." />

      <Label layoutX="410.0" layoutY="65.0" text="Category:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="categoryFilterComboBox" layoutX="480.0" layoutY="60.0" prefHeight="26.0" prefWidth="160.0" />

      <Button layoutX="660.0" layoutY="60.0" mnemonicParsing="false" onAction="#resetSearchBTOnAction" prefHeight="26.0" prefWidth="80.0" text="Reset">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- Articles TableView -->
      <TableView fx:id="articlesTableView" layoutX="30.0" layoutY="100.0" prefHeight="200.0" prefWidth="860.0">
         <columns>
            <TableColumn fx:id="articleIdColumn" prefWidth="90.0" text="Article ID" />
            <TableColumn fx:id="categoryColumn" prefWidth="160.0" text="Category" />
            <TableColumn fx:id="questionColumn" prefWidth="605.0" text="Question / Topic" />
         </columns>
      </TableView>

      <!-- Article Details -->
      <Label fx:id="selectedQuestionLabel" layoutX="30.0" layoutY="310.0" prefHeight="20.0" prefWidth="860.0" text="Select an article to view standard operating response:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextArea fx:id="answerTextArea" editable="false" layoutX="30.0" layoutY="335.0" prefHeight="110.0" prefWidth="860.0" promptText="Standard response &amp; guidelines will appear here..." wrapText="true" />

      <!-- Add New Knowledge Article -->
      <Line endX="760.0" layoutX="130.0" layoutY="460.0" startX="-100.0" stroke="WHITE" />
      <Label layoutX="30.0" layoutY="470.0" text="Add New Knowledge Article / FAQ:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>

      <ComboBox fx:id="newCategoryComboBox" layoutX="30.0" layoutY="495.0" prefHeight="26.0" prefWidth="150.0" promptText="Select Category" />
      <TextField fx:id="newQuestionTextField" layoutX="190.0" layoutY="495.0" prefHeight="26.0" prefWidth="700.0" promptText="Enter Frequently Asked Question / Guide Title..." />
      <TextArea fx:id="newAnswerTextArea" layoutX="30.0" layoutY="530.0" prefHeight="65.0" prefWidth="710.0" promptText="Enter full detailed answer / standard operating procedure..." wrapText="true" />

      <Button layoutX="750.0" layoutY="530.0" mnemonicParsing="false" onAction="#addNewArticleBTOnAction" prefHeight="65.0" prefWidth="140.0" style="-fx-background-color: #27ae60;" text="+ Add Article" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>

      <!-- Back Button -->
      <Button layoutX="815.0" layoutY="610.0" mnemonicParsing="false" onAction="#backBTOnAction" prefHeight="26.0" prefWidth="75.0" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
