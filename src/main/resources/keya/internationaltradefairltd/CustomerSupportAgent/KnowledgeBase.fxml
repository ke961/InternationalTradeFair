<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.CustomerSupportAgent.KnowledgeBaseController">
   <children>
      <VBox layoutX="25.0" layoutY="15.0" prefWidth="900.0" spacing="12.0">
         <children>
            <!-- Title -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label styleClass="badge-pill" text="FAQ REPOSITORY" />
                  <Label styleClass="title-section" text="Standard Operating Procedures &amp; Knowledge Base" />
               </children>
            </HBox>

            <!-- Search Bar Card -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="card-panel" style="-fx-padding: 10 16 10 16;">
               <children>
                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 12px;" text="Search Articles:" />
                  <TextField fx:id="searchTextField" prefHeight="32.0" prefWidth="300.0" promptText="Type keyword (e.g. ticket, timing, gate)..." />

                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 12px;" text="Category:" />
                  <ComboBox fx:id="categoryFilterComboBox" prefHeight="32.0" prefWidth="180.0" />

                  <Button mnemonicParsing="false" onAction="#resetSearchBTOnAction" prefHeight="32.0" prefWidth="80.0" styleClass="btn-secondary" text="Reset" />
               </children>
            </HBox>

            <!-- Articles Table -->
            <TableView fx:id="articlesTableView" prefHeight="190.0" prefWidth="900.0">
               <columns>
                  <TableColumn fx:id="articleIdColumn" prefWidth="90.0" text="Article ID" />
                  <TableColumn fx:id="categoryColumn" prefWidth="170.0" text="Category" />
                  <TableColumn fx:id="questionColumn" prefWidth="630.0" text="Frequently Asked Question / SOP Title" />
               </columns>
            </TableView>

            <!-- Selected Article Response View -->
            <VBox spacing="4.0" styleClass="card-panel" style="-fx-padding: 10 15 10 15;">
               <children>
                  <Label fx:id="selectedQuestionLabel" style="-fx-text-fill: #2dd4bf; -fx-font-weight: bold; -fx-font-size: 12px;" text="Select an article to view standard operating response:" />
                  <TextArea fx:id="answerTextArea" editable="false" prefHeight="70.0" promptText="Standard response &amp; guidelines will appear here..." wrapText="true" />
               </children>
            </VBox>

            <!-- Add New Article Card -->
            <VBox spacing="6.0" styleClass="card-panel" style="-fx-padding: 10 15 10 15;">
               <children>
                  <Label style="-fx-text-fill: #f1f5f9; -fx-font-weight: bold; -fx-font-size: 12px;" text="Contribute New Knowledge Article:" />
                  <HBox spacing="10.0">
                     <children>
                        <ComboBox fx:id="newCategoryComboBox" prefHeight="30.0" prefWidth="160.0" promptText="Category" />
                        <TextField fx:id="newQuestionTextField" HBox.hgrow="ALWAYS" prefHeight="30.0" promptText="Question or Topic Title" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <TextArea fx:id="newAnswerTextArea" HBox.hgrow="ALWAYS" prefHeight="45.0" promptText="Official resolution text / standard answer..." wrapText="true" />
                        <Button mnemonicParsing="false" onAction="#addNewArticleBTOnAction" prefHeight="45.0" prefWidth="130.0" text="+ Add Article" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Back Button -->
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button mnemonicParsing="false" onAction="#backBTOnAction" prefHeight="28.0" prefWidth="90.0" styleClass="btn-secondary" text="← Back" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
