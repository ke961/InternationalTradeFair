<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.CustomerSupportAgent.QuariesController">
   <children>
      <VBox layoutX="25.0" layoutY="15.0" prefWidth="900.0" spacing="12.0">
         <children>
            <!-- Header Title -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label styleClass="badge-pill" text="CUSTOMER CARE" />
                  <Label styleClass="title-section" text="Customer Queries &amp; Support Ticket Resolution Desk" />
               </children>
            </HBox>

            <!-- Filter Bar Card -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="card-panel" style="-fx-padding: 10 16 10 16;">
               <children>
                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 12px;" text="Category:" />
                  <ComboBox fx:id="categoryFilterComboBox" prefHeight="32.0" prefWidth="160.0" />

                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 12px;" text="Status:" />
                  <ComboBox fx:id="statusFilterComboBox" prefHeight="32.0" prefWidth="140.0" />

                  <Button mnemonicParsing="false" onAction="#resetFiltersBTOnAction" prefHeight="32.0" prefWidth="80.0" styleClass="btn-secondary" text="Reset" />
               </children>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="queriesTableView" prefHeight="190.0" prefWidth="900.0">
               <columns>
                  <TableColumn fx:id="queryIdColumn" prefWidth="90.0" text="Ticket ID" />
                  <TableColumn fx:id="customerNameColumn" prefWidth="160.0" text="Customer Name" />
                  <TableColumn fx:id="categoryColumn" prefWidth="130.0" text="Category" />
                  <TableColumn fx:id="subjectColumn" prefWidth="290.0" text="Subject / Inquiry Summary" />
                  <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
                  <TableColumn fx:id="dateColumn" prefWidth="110.0" text="Date Logged" />
               </columns>
            </TableView>

            <!-- Details & Resolution Section (2 Columns) -->
            <HBox spacing="15.0">
               <children>
                  <VBox prefWidth="440.0" spacing="6.0" styleClass="card-panel" style="-fx-padding: 12 15 12 15;">
                     <children>
                        <Label fx:id="selectedQueryHeaderLabel" style="-fx-text-fill: #2dd4bf; -fx-font-weight: bold; -fx-font-size: 12px;" text="Select a ticket from the table above" />
                        <TextArea fx:id="queryDetailsTextArea" editable="false" prefHeight="85.0" promptText="Customer's message/complaint details..." wrapText="true" />
                     </children>
                  </VBox>

                  <VBox prefWidth="445.0" spacing="6.0" styleClass="card-panel" style="-fx-padding: 12 15 12 15;">
                     <children>
                        <Label style="-fx-text-fill: #f1f5f9; -fx-font-weight: bold; -fx-font-size: 12px;" text="Support Agent Resolution / Response Note:" />
                        <TextArea fx:id="resolutionNoteTextArea" prefHeight="55.0" promptText="Type response or actions taken..." wrapText="true" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#markInProgressBTOnAction" prefHeight="28.0" prefWidth="130.0" style="-fx-background-color: #d97706;" text="In Progress" />
                              <Button mnemonicParsing="false" onAction="#markResolvedBTOnAction" prefHeight="28.0" prefWidth="140.0" styleClass="btn-success" text="✓ Resolve &amp; Close" />
                              <Button mnemonicParsing="false" onAction="#reopenQueryBTOnAction" prefHeight="28.0" prefWidth="110.0" styleClass="btn-danger" text="Reopen" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Quick Log New Ticket Form -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card-panel" style="-fx-padding: 8 14 8 14;">
               <children>
                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Log Ticket:" />
                  <TextField fx:id="newCustomerNameTextField" prefHeight="30.0" prefWidth="140.0" promptText="Customer Name" />
                  <TextField fx:id="newCustomerEmailTextField" prefHeight="30.0" prefWidth="150.0" promptText="Email" />
                  <ComboBox fx:id="newCategoryComboBox" prefHeight="30.0" prefWidth="130.0" />
                  <TextField fx:id="newSubjectTextField" HBox.hgrow="ALWAYS" prefHeight="30.0" promptText="Issue Subject / Question" />
                  <Button mnemonicParsing="false" onAction="#logNewQueryBTOnAction" prefHeight="30.0" prefWidth="120.0" text="+ Add Ticket" />
               </children>
            </HBox>

            <!-- Back Button -->
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button mnemonicParsing="false" onAction="#backBTOnAction" prefHeight="28.0" prefWidth="90.0" styleClass="btn-secondary" text="← Back" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
