<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #548581;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.CustomerSupportAgent.QuariesController">
   <children>
      <Label alignment="CENTER" layoutX="300.0" layoutY="15.0" prefHeight="35.0" prefWidth="350.0" text="Customer Queries &amp; Support" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="24.0" />
         </font>
      </Label>
      
      <!-- Filter controls -->
      <Label layoutX="30.0" layoutY="65.0" text="Filter Category:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="categoryFilterComboBox" layoutX="130.0" layoutY="60.0" prefWidth="150.0" />

      <Label layoutX="300.0" layoutY="65.0" text="Filter Status:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="statusFilterComboBox" layoutX="385.0" layoutY="60.0" prefWidth="140.0" />

      <Button layoutX="540.0" layoutY="60.0" mnemonicParsing="false" onAction="#resetFiltersBTOnAction" prefHeight="26.0" prefWidth="80.0" text="Reset">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- Queries TableView -->
      <TableView fx:id="queriesTableView" layoutX="30.0" layoutY="100.0" prefHeight="220.0" prefWidth="890.0">
         <columns>
            <TableColumn fx:id="queryIdColumn" prefWidth="90.0" text="Query ID" />
            <TableColumn fx:id="customerNameColumn" prefWidth="150.0" text="Customer Name" />
            <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category" />
            <TableColumn fx:id="subjectColumn" prefWidth="280.0" text="Subject" />
            <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
            <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
         </columns>
      </TableView>

      <!-- Query Details & Resolution Section -->
      <Line endX="790.0" layoutX="130.0" layoutY="335.0" startX="-100.0" stroke="WHITE" />

      <Label layoutX="30.0" layoutY="345.0" text="Selected Query Details:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <Label fx:id="selectedQueryHeaderLabel" layoutX="190.0" layoutY="345.0" prefHeight="18.0" prefWidth="730.0" text="Select a query from the table above" textFill="#e0f2f1">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>

      <TextArea fx:id="queryDetailsTextArea" editable="false" layoutX="30.0" layoutY="370.0" prefHeight="100.0" prefWidth="430.0" promptText="Customer's message/complaint details..." wrapText="true" />

      <Label layoutX="480.0" layoutY="345.0" text="Agent Resolution / Response Note:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextArea fx:id="resolutionNoteTextArea" layoutX="480.0" layoutY="370.0" prefHeight="100.0" prefWidth="440.0" promptText="Type response or steps taken to resolve the issue..." wrapText="true" />

      <!-- Action Buttons -->
      <Button layoutX="480.0" layoutY="480.0" mnemonicParsing="false" onAction="#markInProgressBTOnAction" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #f39c12;" text="Mark In Progress" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <Button layoutX="630.0" layoutY="480.0" mnemonicParsing="false" onAction="#markResolvedBTOnAction" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #27ae60;" text="Resolve &amp; Close" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <Button layoutX="780.0" layoutY="480.0" mnemonicParsing="false" onAction="#reopenQueryBTOnAction" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #c0392b;" text="Reopen Query" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- New Query Section -->
      <Line endX="790.0" layoutX="130.0" layoutY="525.0" startX="-100.0" stroke="WHITE" />
      <Label layoutX="30.0" layoutY="535.0" text="Quick Log New Customer Query:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="newCustomerNameTextField" layoutX="30.0" layoutY="560.0" prefHeight="26.0" prefWidth="150.0" promptText="Customer Name" />
      <TextField fx:id="newCustomerEmailTextField" layoutX="190.0" layoutY="560.0" prefHeight="26.0" prefWidth="160.0" promptText="Customer Email" />
      <ComboBox fx:id="newCategoryComboBox" layoutX="360.0" layoutY="560.0" prefHeight="26.0" prefWidth="130.0" promptText="Category" />
      <TextField fx:id="newSubjectTextField" layoutX="500.0" layoutY="560.0" prefHeight="26.0" prefWidth="250.0" promptText="Subject / Issue Summary" />
      <Button layoutX="760.0" layoutY="560.0" mnemonicParsing="false" onAction="#logNewQueryBTOnAction" prefHeight="26.0" prefWidth="160.0" style="-fx-background-color: #0e534f;" text="+ Log New Ticket" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- Back Button -->
      <Button layoutX="845.0" layoutY="600.0" mnemonicParsing="false" onAction="#backBTOnAction" prefHeight="30.0" prefWidth="75.0" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
