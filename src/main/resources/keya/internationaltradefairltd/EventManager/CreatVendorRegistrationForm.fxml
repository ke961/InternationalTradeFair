<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.EventManager.CreatVendorRegistrationFormController">
   <children>
      <VBox alignment="CENTER" layoutX="100.0" layoutY="20.0" prefHeight="660.0" prefWidth="750.0" spacing="12.0" styleClass="card-panel" style="-fx-padding: 25 35 25 35;">
         <children>
            <!-- Badge & Header -->
            <Label styleClass="badge-pill" text="EXHIBITOR ONBOARDING FORM" />
            <VBox alignment="CENTER" spacing="2.0">
               <children>
                  <Label styleClass="title-hero" text="Vendor Registration Portal" />
                  <Label styleClass="subtitle-text" text="Register your business to showcase at Dhaka International Trade Fair (DITF)" />
               </children>
            </VBox>

            <!-- Form Content -->
            <VBox prefWidth="680.0" spacing="10.0">
               <children>
                  <!-- Org & Country -->
                  <HBox spacing="12.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Name of Organization / Business *" />
                              <TextField fx:id="organizationNameTextField" prefHeight="34.0" promptText="e.g. Walton Hi-Tech, Sony Corp" />
                           </children>
                        </VBox>
                        <VBox prefWidth="200.0" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Country of Origin" />
                              <ComboBox fx:id="countryComboBox" maxWidth="1.7976931348623157E308" prefHeight="34.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Contact Person -->
                  <HBox spacing="12.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Contact Person (First Name) *" />
                              <TextField fx:id="firstNameTextField" prefHeight="34.0" promptText="First Name" />
                           </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Contact Person (Last Name) *" />
                              <TextField fx:id="lastNameTextField" prefHeight="34.0" promptText="Last Name" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Credentials & Contact -->
                  <HBox spacing="12.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Username (min 4 chars) *" />
                              <TextField fx:id="userNmeTextField" prefHeight="34.0" promptText="Vendor login username" />
                           </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Password (min 6 chars with number) *" />
                              <TextField fx:id="passwordTextField" prefHeight="34.0" promptText="Secure password" />
                           </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                           <children>
                              <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Phone Number *" />
                              <TextField fx:id="phoneNumberTextField1" prefHeight="34.0" promptText="017xxxxxxxx" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Products Description -->
                  <VBox spacing="3.0">
                     <children>
                        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Specific Products / Menu Details *" />
                        <TextArea fx:id="productDetailesTextArea" prefHeight="65.0" promptText="Describe categories, exhibition showcase items, and product lines..." wrapText="true" />
                     </children>
                  </VBox>

                  <!-- Special Requests -->
                  <VBox spacing="3.0">
                     <children>
                        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 11px;" text="Special Logistics Requests (Power, Water, Corner Booth) [Optional]" />
                        <TextArea fx:id="requestsTextArea" prefHeight="50.0" promptText="e.g. 3-phase electricity line, water connection, corner stall..." wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- Submit Button -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#RegisterBTOnAction" prefHeight="38.0" style="-fx-font-size: 13px;" text="Submit Vendor Application ✓" />

            <!-- Bottom Navigation -->
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <HBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8;" text="Already registered?" />
                        <Button mnemonicParsing="false" onAction="#loginOnAction" style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #2dd4bf; -fx-font-weight: bold;" text="Login" underline="true" />
                     </children>
                  </HBox>
                  <Label style="-fx-text-fill: #475569;" text="|" />
                  <Button mnemonicParsing="false" onAction="#regBackBTOnAction" prefHeight="28.0" prefWidth="90.0" styleClass="btn-secondary" text="← Back" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
