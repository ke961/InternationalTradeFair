<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.EventManager.ViewReportsController">
   <children>
      <TabPane fx:id="mainTab" prefHeight="650.0" prefWidth="950.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <!-- Tab 1: All Reports -->
          <Tab fx:id="reportsTab" text="Trade Fair Audit &amp; Incident Reports">
             <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="600.0" prefWidth="950.0">
                   <children>
                      <VBox layoutX="30.0" layoutY="20.0" prefWidth="890.0" spacing="15.0">
                         <children>
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                               <children>
                                  <Label styleClass="title-section" text="Daily Operations, Gate Revenue &amp; Safety Reports" />
                                  <Button mnemonicParsing="false" onAction="#viewReportsBTOnAction" style="-fx-padding: 5px 12px;" text="Refresh Reports" />
                               </children>
                            </HBox>

                            <TableView fx:id="reportTableView" prefHeight="390.0" prefWidth="890.0">
                               <columns>
                                  <TableColumn fx:id="userTypeTableColumn" prefWidth="220.0" text="Reporter Role" />
                                  <TableColumn fx:id="userNameTableColumn" prefWidth="260.0" text="Reporting Authority / User" />
                                  <TableColumn fx:id="reportContentTableColumn" prefWidth="405.0" text="Summary &amp; Incident Findings" />
                               </columns>
                            </TableView>

                            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                               <children>
                                  <Button mnemonicParsing="false" onAction="#viewReportDetailesBTOnAction" prefHeight="35.0" prefWidth="170.0" text="Inspect Report Details →" />
                                  <Button mnemonicParsing="false" onAction="#reportBackBTOnAction" prefHeight="35.0" prefWidth="110.0" styleClass="btn-secondary" text="← Dashboard" />
                               </children>
                            </HBox>
                         </children>
                      </VBox>
                   </children>
                </AnchorPane>
             </content>
          </Tab>

          <!-- Tab 2: Report Details -->
          <Tab text="Report Deep-Dive">
             <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="600.0" prefWidth="950.0">
                   <children>
                      <VBox alignment="CENTER" layoutX="175.0" layoutY="50.0" prefHeight="480.0" prefWidth="600.0" spacing="18.0" styleClass="card-panel" style="-fx-padding: 30 35 30 35;">
                         <children>
                            <Label styleClass="badge-pill" text="DETAILED AUDIT LOG" />
                            <Label styleClass="title-section" text="Exhibition Incident &amp; Performance Audit" />

                            <VBox prefWidth="530.0" spacing="12.0">
                               <children>
                                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                                     <children>
                                        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;" text="Filter By Role:" />
                                        <ComboBox fx:id="userTypeComboBox" prefHeight="32.0" prefWidth="200.0" />
                                     </children>
                                  </HBox>

                                  <VBox spacing="4.0">
                                     <children>
                                        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;" text="Author / Authority:" />
                                        <Label fx:id="userNameLable" style="-fx-text-fill: #2dd4bf; -fx-font-size: 14px; -fx-font-weight: bold;" text="Select a report to view" />
                                     </children>
                                  </VBox>

                                  <VBox spacing="4.0">
                                     <children>
                                        <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;" text="Report Statement &amp; Corrective Measures:" />
                                        <Label fx:id="reportAboutLable" alignment="TOP_LEFT" prefHeight="170.0" prefWidth="530.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8; -fx-padding: 12; -fx-text-fill: #f8fafc;" text="Report body will be rendered here..." wrapText="true" />
                                     </children>
                                  </VBox>
                               </children>
                            </VBox>

                            <Button mnemonicParsing="false" onAction="#detBackBTOnAction" prefHeight="32.0" prefWidth="120.0" styleClass="btn-secondary" text="← Back to List" />
                         </children>
                      </VBox>
                   </children>
                </AnchorPane>
             </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
