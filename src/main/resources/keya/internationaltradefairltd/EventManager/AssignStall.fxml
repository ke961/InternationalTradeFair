<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.EventManager.AssignStallController">
   <children>
      <TabPane fx:id="MainTab" prefHeight="650.0" prefWidth="950.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <!-- Tab 1: Assign Stall Overview -->
          <Tab fx:id="assignStallTab" text="Stall Center">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="600.0" prefWidth="950.0">
                     <children>
                        <VBox alignment="CENTER" layoutX="225.0" layoutY="80.0" prefHeight="420.0" prefWidth="500.0" spacing="25.0" styleClass="card-panel" style="-fx-padding: 35 40 35 40;">
                           <children>
                              <Label styleClass="badge-pill" text="PAVILION &amp; STALL CONTROL" />
                              <VBox alignment="CENTER" spacing="5.0">
                                 <children>
                                    <Label styleClass="title-hero" text="Stall Management" />
                                    <Label styleClass="subtitle-text" text="Configure booth spaces, monitor allotment status, and assign stalls" textAlignment="CENTER" />
                                 </children>
                              </VBox>
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#creatAndShowBTOnAction" prefHeight="48.0" styleClass="btn-nav-card" text="➕  Create New Stall &amp; View All Stalls" />
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ViewAvailableBTOnAction" prefHeight="48.0" styleClass="btn-nav-card" text="🔍  View Available Stalls &amp; Assign to Vendors" />
                              <Button mnemonicParsing="false" onAction="#assignStallBackButtonOnAction" prefHeight="32.0" prefWidth="120.0" styleClass="btn-secondary" text="← Dashboard" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>

          <!-- Tab 2: Create & Details -->
          <Tab fx:id="createDetailsTab" text="Create &amp; Details">
             <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="600.0" prefWidth="950.0">
                   <children>
                      <VBox layoutX="30.0" layoutY="20.0" prefWidth="890.0" spacing="15.0">
                         <children>
                            <!-- Create Stall Form Card -->
                            <VBox spacing="10.0" styleClass="card-panel" style="-fx-padding: 15 20 15 20;">
                               <children>
                                  <Label styleClass="title-section" text="Create New Exhibition Stall" />
                                  <HBox spacing="12.0">
                                     <children>
                                        <TextField fx:id="stallIDTextField" prefHeight="35.0" prefWidth="170.0" promptText="Stall ID (e.g. ST-205)" />
                                        <TextField fx:id="stallLocationTextField" prefHeight="35.0" prefWidth="250.0" promptText="Stall Location (e.g. Hall C)" />
                                        <TextField fx:id="stallSizeTextField" prefHeight="35.0" prefWidth="160.0" promptText="Size (sq ft)" />
                                        <TextField fx:id="rentTextField" prefHeight="35.0" prefWidth="160.0" promptText="Rent (BDT)" />
                                        <Button mnemonicParsing="false" onAction="#createStallBTOnAction" prefHeight="35.0" prefWidth="120.0" text="+ Add Stall" />
                                     </children>
                                  </HBox>
                               </children>
                            </VBox>

                            <!-- Table & Filter -->
                            <VBox spacing="8.0">
                               <children>
                                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                                     <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #cbd5e1;" text="Filter Stalls:" />
                                        <ComboBox fx:id="stallIdComboBox" prefHeight="30.0" prefWidth="180.0" />
                                        <Button mnemonicParsing="false" onAction="#showDTBTOnAction" prefHeight="30.0" prefWidth="120.0" styleClass="btn-secondary" text="Apply Filter" />
                                     </children>
                                  </HBox>
                                  <TableView fx:id="stallsTableView" prefHeight="260.0" prefWidth="890.0">
                                     <columns>
                                        <TableColumn fx:id="stallIDTableColumn" prefWidth="150.0" text="Stall ID" />
                                        <TableColumn fx:id="stallSizeTableColumn" prefWidth="180.0" text="Stall Size (sq ft)" />
                                        <TableColumn fx:id="stallLocationTableColumn" prefWidth="320.0" text="Stall Location" />
                                        <TableColumn fx:id="rentTableColumn" prefWidth="230.0" text="Rent (BDT)" />
                                     </columns>
                                  </TableView>
                               </children>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT">
                               <children>
                                  <Button mnemonicParsing="false" onAction="#creatAndDetBackBTOnAction" prefHeight="30.0" prefWidth="90.0" styleClass="btn-secondary" text="← Back" />
                               </children>
                            </HBox>
                         </children>
                      </VBox>
                   </children>
                </AnchorPane>
             </content>
          </Tab>

          <!-- Tab 3: Assign Stall to Company -->
          <Tab fx:id="availableStallsTab" text="Allotment &amp; Availability">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="600.0" prefWidth="950.0">
                 <children>
                    <VBox layoutX="30.0" layoutY="15.0" prefWidth="890.0" spacing="12.0">
                       <children>
                          <!-- Top row: Tables for Available Stalls and Approved Vendors -->
                          <HBox spacing="15.0">
                             <children>
                                <VBox prefWidth="440.0" spacing="6.0">
                                   <children>
                                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                                         <children>
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2dd4bf;" text="Available Stalls:" />
                                            <Button mnemonicParsing="false" onAction="#availableStallBTOnAction" style="-fx-padding: 3px 10px; -fx-font-size: 11px;" text="Refresh" />
                                         </children>
                                      </HBox>
                                      <TableView fx:id="availableStallTableView" prefHeight="150.0" prefWidth="440.0">
                                        <columns>
                                          <TableColumn fx:id="availableStallIdTavleColumn" prefWidth="90.0" text="Stall ID" />
                                          <TableColumn fx:id="availStallSizeTableColumn" prefWidth="100.0" text="Size (sq ft)" />
                                          <TableColumn fx:id="availableStallSizeTableColumn" prefWidth="140.0" text="Location" />
                                          <TableColumn fx:id="availavleRentTableColumn" prefWidth="105.0" text="Rent (BDT)" />
                                        </columns>
                                      </TableView>
                                   </children>
                                </VBox>

                                <VBox prefWidth="435.0" spacing="6.0">
                                   <children>
                                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                                         <children>
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2dd4bf;" text="Approved Vendors (Ready for Allotment):" />
                                            <Button mnemonicParsing="false" onAction="#showCompanyBTOnAction" style="-fx-padding: 3px 10px; -fx-font-size: 11px;" text="Refresh" />
                                         </children>
                                      </HBox>
                                      <TableView fx:id="approvedCompanyTableView" prefHeight="150.0" prefWidth="435.0">
                                        <columns>
                                          <TableColumn fx:id="showApprovedCompantTableColumn" prefWidth="430.0" text="Approved Company Name" />
                                        </columns>
                                      </TableView>
                                   </children>
                                </VBox>
                             </children>
                          </HBox>

                          <!-- Allotment Input Bar -->
                          <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-panel" style="-fx-padding: 10 15 10 15;">
                             <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9;" text="Assign Stall:" />
                                <TextField fx:id="enterCompanyNameTextField" prefHeight="32.0" prefWidth="250.0" promptText="Select/Enter Company Name" />
                                <TextField fx:id="enterStallIDTextField" prefHeight="32.0" prefWidth="180.0" promptText="Select/Enter Stall ID" />
                                <Button mnemonicParsing="false" onAction="#assignBTOnAction" prefHeight="32.0" prefWidth="150.0" styleClass="btn-success" text="✓ Confirm Allotment" />
                             </children>
                          </HBox>

                          <!-- Assigned Stalls Table -->
                          <VBox spacing="5.0">
                             <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #cbd5e1;" text="Currently Assigned &amp; Occupied Stalls:" />
                                <TableView fx:id="assignStallTableView" prefHeight="170.0" prefWidth="890.0">
                                   <columns>
                                      <TableColumn fx:id="assignCompTableColumn" prefWidth="240.0" text="Company Name" />
                                      <TableColumn fx:id="assignstallIDTableColumn" prefWidth="130.0" text="Stall ID" />
                                      <TableColumn fx:id="assignStallSizeTableColumn" prefWidth="130.0" text="Size (sq ft)" />
                                      <TableColumn fx:id="assignStallLocationTableColumn" prefWidth="210.0" text="Location" />
                                      <TableColumn fx:id="assignRentTableColumn" prefWidth="170.0" text="Rent (BDT)" />
                                   </columns>
                                </TableView>
                             </children>
                          </VBox>

                          <HBox alignment="CENTER_RIGHT">
                             <children>
                                <Button mnemonicParsing="false" onAction="#availableAndAssignBackBTOnAction" prefHeight="28.0" prefWidth="90.0" styleClass="btn-secondary" text="← Back" />
                             </children>
                          </HBox>
                       </children>
                    </VBox>
                 </children>
              </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
