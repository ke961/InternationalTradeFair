<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="530.0" prefWidth="787.0" style="-fx-background-color: #548581;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.EventManager.ViewRequestsViewController">
   <children>
      <Label alignment="CENTER" layoutX="240.0" layoutY="20.0" prefHeight="35.0" prefWidth="320.0" text="Vendor Special Requests" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="22.0" />
         </font>
      </Label>
      <Label layoutX="172.0" layoutY="68.0" text="Select Vendor / Organization:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="vendorComboBox" layoutX="360.0" layoutY="64.0" prefHeight="26.0" prefWidth="302.0" promptText="Select Vendor" />
      <TextArea fx:id="requestsDetailesTextField" editable="false" layoutX="172.0" layoutY="102.0" prefHeight="200.0" prefWidth="490.0" wrapText="true" />
      <Button fx:id="approveBT" layoutX="172.0" layoutY="318.0" mnemonicParsing="false" onAction="#rqstApproveBTOnAction" prefHeight="32.0" prefWidth="490.0" style="-fx-background-color: #27ae60;" text="Approve Special Request" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="rejectBT" layoutX="172.0" layoutY="360.0" mnemonicParsing="false" onAction="#rqstRejectBTOnAction" prefHeight="32.0" prefWidth="490.0" style="-fx-background-color: #c0392b;" text="Reject Special Request" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button layoutX="680.0" layoutY="470.0" mnemonicParsing="false" onAction="#rDetlbackBTOnAction" prefHeight="30.0" prefWidth="75.0" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
