<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.EventManager.ViewRequestsViewController">
   <children>
      <VBox alignment="CENTER" layoutX="140.0" layoutY="35.0" prefHeight="570.0" prefWidth="670.0" spacing="18.0" styleClass="card-panel" style="-fx-padding: 30 35 30 35;">
         <children>
            <!-- Badge & Header -->
            <Label styleClass="badge-pill" text="LOGISTICS &amp; SPECIAL PROVISIONS" />
            <VBox alignment="CENTER" spacing="3.0">
               <children>
                  <Label styleClass="title-hero" text="Vendor Special Requests" />
                  <Label styleClass="subtitle-text" text="Review high-voltage power, water drainage, and corner spot allotment requests" />
               </children>
            </VBox>

            <!-- Vendor Dropdown -->
            <VBox prefWidth="600.0" spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 12px;" text="Select Exhibitor Organization:" />
                  <ComboBox fx:id="vendorComboBox" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Choose Vendor to Inspect" />
               </children>
            </VBox>

            <!-- Request Details Box -->
            <VBox prefWidth="600.0" spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold; -fx-font-size: 12px;" text="Request Details &amp; Technical Specifications:" />
                  <TextArea fx:id="requestsDetailesTextField" editable="false" prefHeight="170.0" promptText="Logistics specifications will appear here..." wrapText="true" />
               </children>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="approveBT" mnemonicParsing="false" onAction="#rqstApproveBTOnAction" prefHeight="38.0" prefWidth="220.0" styleClass="btn-success" text="✓ Approve Logistics Request" />
                  <Button fx:id="rejectBT" mnemonicParsing="false" onAction="#rqstRejectBTOnAction" prefHeight="38.0" prefWidth="200.0" styleClass="btn-danger" text="✕ Reject Request" />
               </children>
            </HBox>

            <!-- Back Button -->
            <Button mnemonicParsing="false" onAction="#rDetlbackBTOnAction" prefHeight="30.0" prefWidth="100.0" styleClass="btn-secondary" text="← Dashboard" />
         </children>
      </VBox>
   </children>
</AnchorPane>
