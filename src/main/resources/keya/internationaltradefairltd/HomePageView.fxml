<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="780.0" styleClass="app-gradient-bg" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="keya.internationaltradefairltd.HomePageViewController">
   <children>
      <VBox alignment="CENTER" layoutX="140.0" layoutY="50.0" prefHeight="440.0" prefWidth="500.0" spacing="22.0" styleClass="card-panel" style="-fx-padding: 35 40 35 40;">
         <children>
            <!-- Badge -->
            <Label styleClass="badge-pill" text="✨ DHAKA INTERNATIONAL TRADE FAIR 2026" />

            <!-- Title -->
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label styleClass="title-hero" text="Welcome to DITF Portal" textAlignment="CENTER" />
                  <Label styleClass="subtitle-text" text="Unified Exhibition, Allotment &amp; Customer Care Management System" textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>

            <!-- Selection Box -->
            <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="8.0">
               <children>
                  <Label style="-fx-text-fill: #cbd5e1; -fx-font-weight: bold;" text="Select Your Role / Portal:" />
                  <ComboBox fx:id="userTypeComboBox" maxWidth="1.7976931348623157E308" prefHeight="40.0" promptText="Select User Role" />
               </children>
            </VBox>

            <!-- Action Button -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#nextBTOnAction" prefHeight="42.0" style="-fx-font-size: 14px;" text="Continue to Login →" />

            <!-- Footer info -->
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Organized by Export Promotion Bureau (EPB) &amp; Trade Fair Committee" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
